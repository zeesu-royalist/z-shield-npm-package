{
  "name": "z-shield",
  "version": "0.1.4",
  "description": "API abuse detection, rate limiting, and temporary IP blocking middleware for Node.js and Express",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "next": [
        "dist/next.d.ts"
      ]
    }
  },
  "bin": {
    "z-shield": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "start": "node examples/express-app.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeesu-royalist/z-shield-npm-package.git"
  },
  "bugs": {
    "url": "https://github.com/zeesu-royalist/z-shield-npm-package/issues"
  },
  "homepage": "https://github.com/zeesu-royalist/z-shield-npm-package#readme",
  "keywords": [
    "security",
    "rate-limit",
    "abuse-detection",
    "express",
    "middleware",
    "api-protection"
  ],
  "author": "zeesu-royalist (https://zeesu-royalist.vercel.app)",
  "license": "MIT",
  "files": [
    "dist",
    "next.js",
    "next.d.ts",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "express": "^4.21.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
